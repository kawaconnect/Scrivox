{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements(-torch-cu126)?\\.lock$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "requirements.txt is a pip-compile source: update it (and the locks) through the pip-compile manager only, not a second time through pip_requirements",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.txt"
      ],
      "enabled": false
    }
  ]
}
